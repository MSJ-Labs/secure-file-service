# Copy to application-local.properties (git-ignored) and run with --spring.profiles.active=local.
# Values match the defaults of docker-compose.yml / .env.example.

app.security.oauth2.issuer-uri=http://localhost:8180/realms/secure-file

spring.datasource.url=jdbc:postgresql://localhost:5432/training
spring.datasource.username=postgres
spring.datasource.password=postgres

app.storage.s3.endpoint=http://localhost:4566
app.storage.s3.access-key=change-me
app.storage.s3.secret-key=change-me-too

app.scanner.clamav.host=localhost
app.scanner.clamav.port=3310
