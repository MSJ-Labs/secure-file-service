# Copy to .env (git-ignored) and change the values. Used by docker-compose.yml.

POSTGRES_DB=securefile
POSTGRES_USER=securefile
POSTGRES_PASSWORD=change-me

# LocalStack accepts any credentials; against real S3 these must be real ones.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_REGION=us-east-1
S3_QUARANTINE_BUCKET=quarantine
S3_CLEAN_BUCKET=clean
# Host port of PostgreSQL; change it if 5432 is already taken on your machine.
POSTGRES_HOST_PORT=5432
