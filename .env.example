# Copy to .env (git-ignored) and change the values. Used by docker-compose.yml.

POSTGRES_DB=securefile
POSTGRES_USER=securefile
POSTGRES_PASSWORD=change-me

# LocalStack accepts any credentials; against real S3 these must be real ones.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_REGION=us-east-1
S3_QUARANTINE_BUCKET=quarantine
S3_CLEAN_BUCKET=clean
# Host port of PostgreSQL; change it if 5432 is already taken on your machine.
POSTGRES_HOST_PORT=5432

# Keycloak (identity provider), local dev values: use strong unique ones elsewhere.
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secret of the bootstrap service account "terraform" (master realm). Keycloak creates it at first start, Terraform
# (repo trading-infra) logs in with it: use the same value in its .env. Generate with: openssl rand -base64 32
TERRAFORM_CLIENT_SECRET=
